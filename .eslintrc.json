{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "extends": ["eslint:recommended", "plugin:react/recommended"],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "plugins": ["react"],
  "rules": {
    "react/prop-types": "off",
    "no-console": ["error", { "allow": ["[Render Guardian]"] }],
    "no-unused-vars": "warn",
    "eqeqeq": "error",
    "strict": "off"
  }
}